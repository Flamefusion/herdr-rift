#!/usr/bin/env python3
"""Claude Code hook: records what a champion is doing so the Rift map can show it.

Usage (from settings/<id>.json): rift-hook <champion-id>, hook JSON on stdin.
Writes <app home>/rift-state/<champion-id>.json. Never blocks or fails the tool.
"""
import json
import os
import re
import sys
import time

TESTS = re.compile(r"\b(pytest|ctest|twister|tox|unittest|make\s+(test|check|validate)|west\s+test|(npm|pnpm|yarn)\s+(run\s+)?test|cargo\s+test|go\s+test)\b")
HARDWARE = re.compile(r"\b(nrfjprog|nrfutil|west\s+flash|pyocd|JLinkExe|openocd|mcumgr|dfu-util|renode|ssh|scp|rsync)\b")
BUILD = re.compile(r"\b(make|cmake|ninja|west\s+build|cargo\s+build|gcc|clang|dpkg-buildpackage|docker\s+build|(npm|pnpm|yarn)\s+(run\s+)?build)\b")
WAITING = re.compile(r"(^|[;&|]\s*)sleep\b|\bgh\s+run\s+watch\b|--watch\b")
SEARCH = re.compile(r"\b(rg|grep|find|fd|ag|git\s+(log|blame|grep|bisect|show|diff))\b")
DOCS = re.compile(r"\.(md|rst|txt|pdf|adoc|html?)$", re.I)


def classify(tool, inp):
    if tool in ("WebSearch", "WebFetch"):
        return "research"
    if tool == "Read":
        return "research" if DOCS.search(str(inp.get("file_path", ""))) else "search"
    if tool in ("Grep", "Glob"):
        return "search"
    if tool == "Bash":
        cmd = str(inp.get("command", ""))
        for name, rx in (("tests", TESTS), ("hardware", HARDWARE), ("build", BUILD), ("waiting", WAITING), ("search", SEARCH)):
            if rx.search(cmd):
                return name
    return None


def main():
    if len(sys.argv) < 2:
        return
    champ = re.sub(r"[^a-z0-9_-]", "", sys.argv[1].lower())
    try:
        event = json.load(sys.stdin)
    except Exception:
        return
    activity = None
    if event.get("hook_event_name") == "PreToolUse":
        activity = classify(event.get("tool_name", ""), event.get("tool_input") or {})
    home = os.environ.get("HERDR_APP_HOME") or os.path.expanduser("~/.config/herdr-app")
    folder = os.path.join(home, "rift-state")
    os.makedirs(folder, exist_ok=True)
    path = os.path.join(folder, champ + ".json")
    tmp = path + ".%d.tmp" % os.getpid()
    with open(tmp, "w") as f:
        json.dump({"champ": champ, "activity": activity, "since": int(time.time() * 1000)}, f)
    os.replace(tmp, path)


try:
    main()
except Exception:
    pass
sys.exit(0)
